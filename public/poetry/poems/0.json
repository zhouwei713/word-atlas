[{"id":"ba-zhen-tu-du-fu","title":"八阵图","author":"杜甫","dynasty":"唐","form":"五言绝句","themes":["怀古","哲理","写人"],"level":0,"lines":[{"zh":"功盖三分国，","py":["gōng","gài","sān","fēn","guó",""]},{"zh":"名成八阵图。","py":["míng","chéng","bā","zhèn","tú",""]},{"zh":"江流石不转，","py":["jiāng","liú","shí","bù","zhuǎn",""]},{"zh":"遗恨失吞吴。","py":["yí","hèn","shī","tūn","wú",""]}],"gist":""},{"id":"cai-lian-qu-liu-fang-ping","title":"采莲曲","author":"刘方平","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"落日清江里，","py":["luò","rì","qīng","jiāng","lǐ",""]},{"zh":"荆歌艳楚腰。","py":["jīng","gē","yàn","chǔ","yāo",""]},{"zh":"采莲从小惯，","py":["cǎi","lián","cóng","xiǎo","guàn",""]},{"zh":"十五即乘潮。","py":["shí","wǔ","jí","chéng","cháo",""]}],"gist":"西落的太阳余辉照着清澈的江水，荆楚民歌让姑娘们更艳丽。她们从小习惯采莲，十五岁一过就开始上船在水中劳动。"},{"id":"chi-shang-bai-ju-yi","title":"池上","author":"白居易","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"小娃撑小艇，","py":["xiǎo","wá","chēng","xiǎo","tǐng",""]},{"zh":"偷采白莲回。","py":["tōu","cǎi","bái","lián","huí",""]},{"zh":"不解藏踪迹，","py":["bù","jiě","cáng","zōng","jì",""]},{"zh":"浮萍一道开。","py":["fú","píng","yī","dào","kāi",""]}],"gist":"此诗描写孩子的天真无邪。　　小娃撑着小船，到池上去偷采白色的莲篷。他们还不会隐藏自已的踪迹，在浮萍上留下一条明显的水路。"},{"id":"chun-xue-liu-fang-ping","title":"春雪","author":"刘方平","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"飞雪带春风，","py":["fēi","xuě","dài","chūn","fēng",""]},{"zh":"徘徊乱绕空。","py":["pái","huái","luàn","rào","kōng",""]},{"zh":"君看似花处，","py":["jūn","kàn","shì","huā","chù",""]},{"zh":"偏在洛城东。","py":["piān","zài","luò","chéng","dōng",""]}],"gist":"春风携带着雪花，在空中徘徊、狂舞。请君观察，在洛城东的豪门宅第，雪花并不寒冷，并像花一样美。"},{"id":"chun-yuan-jin-chang-xu","title":"春怨","author":"金昌绪","dynasty":"唐","form":"五言绝句","themes":["怀人","闺怨"],"level":0,"lines":[{"zh":"打起黄莺儿，","py":["dǎ","qǐ","huáng","yīng","ér",""]},{"zh":"莫教枝上啼。","py":["mò","jiào","zhī","shàng","tí",""]},{"zh":"啼时惊妾梦，","py":["tí","shí","jīng","qiè","mèng",""]},{"zh":"不得到辽西。","py":["bù","dé","dào","liáo","xī",""]}],"gist":"这首诗写女子思念远征辽西的丈夫，反映战争拆散年轻夫妇，离散给人民带来的痛苦。　　赶走黄莺儿，不让它在树枝上啼叫。它的叫声惊醒了我的好梦，使我不能在梦中去辽西和丈夫相见。"},{"id":"deng-le-you-yuan-li-shang-yin","title":"登乐游原","author":"李商隐","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"向晚意不适，","py":["xiàng","wǎn","yì","bù","shì",""]},{"zh":"驱车登古原。","py":["qū","chē","dēng","gǔ","yuán",""]},{"zh":"夕阳无限好，","py":["xī","yáng","wú","xiàn","hǎo",""]},{"zh":"只是近黄昏。","py":["zhǐ","shì","jìn","huáng","hūn",""]}],"gist":"诗写傍晚登上乐游原所见的景色和深刻的感慨。　　傍晚时分情绪不好，驾车登上古原。只见夕阳西下，尽管它美好无限，只可惜已近黄昏，要下山了。"},{"id":"du-han-jiang-li-pin","title":"渡汉江","author":"李频","dynasty":"唐","form":"五言绝句","themes":["思乡","渡江"],"level":0,"lines":[{"zh":"岭外音书绝，","py":["lǐng","wài","yīn","shū","jué",""]},{"zh":"经冬复立春。","py":["jīng","dōng","fù","lì","chūn",""]},{"zh":"近乡情更怯，","py":["jìn","xiāng","qíng","gèng","qiè",""]},{"zh":"不敢问来人。","py":["bù","gǎn","wèn","lái","rén",""]}],"gist":"这首诗通过表现游子归来时，临到家门口前的心理变化和紧张情绪，反映出他对家乡的一片深情。　　离家到五岭以外偏远的地方客居，与家乡音书断绝，冬去春来，一年又一年。游子归来，临近家门时心情更加紧张，怕家中发生什么变故，不敢询问迎面走来的人。"},{"id":"feng-xue-su-bian-rong-shan-zhu-ren-liu-zhang-qing","title":"逢雪宿鞭蓉山主人","author":"刘长卿","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"日暮苍山远，","py":["rì","mù","cāng","shān","yuǎn",""]},{"zh":"天寒白屋贫。","py":["tiān","hán","bái","wū","pín",""]},{"zh":"柴门闻犬吠，","py":["chái","mén","wén","quǎn","fèi",""]},{"zh":"风雪夜归人。","py":["fēng","xuě","yè","guī","rén",""]}],"gist":"太阳下山，风雪到来，青山显更加模糊遥远。投宿一家贫寒的山民家，他家的房屋空空，很有几分寒冷。深夜，用柴草编成的门外传来狗的叫声，主人冒雪归来。"},{"id":"ge-shu-ge-xi-bi-ren","title":"哥舒歌","author":"西鄙人","dynasty":"唐","form":"五言绝句","themes":["赞颂","民歌"],"level":0,"lines":[{"zh":"北斗七星高，","py":["běi","dǒu","qī","xīng","gāo",""]},{"zh":"哥舒夜带刀。","py":["gē","shū","yè","dài","dāo",""]},{"zh":"至今窥牧马，","py":["zhì","jīn","kuī","mù","mǎ",""]},{"zh":"不敢过临洮。","py":["bù","gǎn","guò","lín","táo",""]}],"gist":"哥舒指哥舒翰，是唐玄宗的大将，突厥族哥舒部的后裔。　　北斗七星高照，哥舒翰夜巡，严守边防。到现在胡骑(敌军)只能远远地窥探，却不敢轻举妄动，轻易地越过临洮。"},{"id":"gu-zhu-cheng-qu-er-shou-yuan-zhen","title":"古筑城曲（二首）","author":"元稹","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"筑城须努力，","py":["zhù","chéng","xū","nǔ","lì",""]},{"zh":"城高遮得贼。","py":["chéng","gāo","zhē","dé","zéi",""]},{"zh":"但恐贼路多，","py":["dàn","kǒng","zéi","lù","duō",""]},{"zh":"有城遮不得。","py":["yǒu","chéng","zhē","bù","dé",""]}],"gist":"筑城安敢烦，愿听丁一言。请筑鸿胪寺，兼愁虏出关。　　努力地修筑长城，长城高就可以阻挡盗贼的入侵。但是恐怕盗贼的路子多，就是有长城也阻挡不了。　　筑城不敢厌烦，但愿能听取一种说法。希望多修筑接待外宾的像鸿胪寺这样的宫室，况且城防坚固，反使俘虏不能出去，必为内乱。"},{"id":"gui-yuan-ci-bai-ju-yi","title":"闺怨词","author":"白居易","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"关山征戍远，","py":["guān","shān","zhēng","shù","yuǎn",""]},{"zh":"闺阁别离难。","py":["guī","gé","bié","lí","nán",""]},{"zh":"苦战应憔悴，","py":["kǔ","zhàn","yīng","qiáo","cuì",""]},{"zh":"寒衣不要宽。","py":["hán","yī","bú","yào","kuān",""]}],"gist":"诗写闺阁的妇女为远征的亲人制作寒衣，不仅表现思念心切，还从侧面反映戍边生活的艰苦卓绝。　　到偏远的边关要塞去打仗，家人难分难舍。经历许多艰苦的战斗，人一定会消瘦，寒衣不要做得太宽大。"},{"id":"he-man-zi-zhang-hu","title":"何满子","author":"张祜","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"故国三千里，","py":["gù","guó","sān","qiān","lǐ",""]},{"zh":"深宫二十年。","py":["shēn","gōng","èr","shí","nián",""]},{"zh":"一声何满子，","py":["yī","shēng","hé","mǎn","zi",""]},{"zh":"双泪落君前。","py":["shuāng","lèi","luò","jūn","qián",""]}],"gist":"诗写宫女的哀怨。相传唐文宗病重时想让孟才人以死相殉，孟歌《何满子》一声肠断而殒。作者以诗吊之。　　远离家乡三千里，深居宫中二十年。凄惨地唱一声《何满子》，在君王的面前，眼泪哗哗地流，到头来不免要惨死相殉。"},{"id":"jiang-nan-qu-li-yi","title":"江南曲","author":"李益","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"嫁得瞿塘贾，","py":["jià","dé","qú","táng","jiǎ",""]},{"zh":"朝朝误妾期。","py":["cháo","cháo","wù","qiè","qī",""]},{"zh":"早知潮有信，","py":["zǎo","zhī","cháo","yǒu","xìn",""]},{"zh":"嫁与弄潮儿。","py":["jià","yǔ","nòng","cháo","ér",""]}],"gist":"此诗摹拟商人妻子的口吻写别离的哀怨。　　嫁给瞿塘的商人，每天都耽误约定的时期。早知道潮水涨落有定时，不如嫁给弄潮的人。"},{"id":"jiang-niu-he-chu-qu-er-shou-yuan-jie","title":"将牛何处去（二首）","author":"元结","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"将牛何处去，","py":["jiāng","niú","hé","chù","qù",""]},{"zh":"耕彼故城东。","py":["gēng","bǐ","gù","chéng","dōng",""]},{"zh":"相伴有田父，","py":["xiāng","bàn","yǒu","tián","fǔ",""]},{"zh":"相欢惟牧童。","py":["xiāng","huān","wéi","mù","tóng",""]}],"gist":"将牛何处去，耕彼西阳城。叔闲修家具，直者伴我耕。　　牵牛到什么地方去？去故城东耕种那里的田地。老农和我做伴，还有牧童高兴地在那里玩耍。牵牛到什么地方去？去耕种西阳城的田地。叔闲帮助修农具，长子和我一道耕种。"},{"id":"jiang-xue-liu-zong-yuan","title":"江雪","author":"柳宗元","dynasty":"唐","form":"五言绝句","themes":["写雪","山水","雪","冬","写景","写鸟","鸟"],"level":0,"lines":[{"zh":"千山鸟飞绝，","py":["qiān","shān","niǎo","fēi","jué",""]},{"zh":"万径人踪灭。","py":["wàn","jìng","rén","zōng","miè",""]},{"zh":"孤舟蓑笠翁，","py":["gū","zhōu","suō","lì","wēng",""]},{"zh":"独钓寒江雪。","py":["dú","diào","hán","jiāng","xuě",""]}],"gist":""},{"id":"liu-lu-qin-qing-si-kong-shu","title":"留卢秦卿","author":"司空曙","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"知有前期在，","py":["zhī","yǒu","qián","qī","zài",""]},{"zh":"难分此夜中。","py":["nán","fēn","cǐ","yè","zhōng",""]},{"zh":"无将故人酒，","py":["wú","jiāng","gù","rén","jiǔ",""]},{"zh":"不及石尤风。","py":["bù","jí","shí","yóu","fēng",""]}],"gist":"知道在这以前就决定，今天晚上就要分手，实在是难分难舍。老朋友备酒也留不住你，岂不是故人的酒，不及石尤风(阻挡行船的逆风)能阻止你的行程！"},{"id":"lu-chai-wang-wei","title":"鹿柴","author":"王维","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"空山不见人，","py":["kōng","shān","bú","jiàn","rén",""]},{"zh":"但闻人语响。","py":["dàn","wén","rén","yǔ","xiǎng",""]},{"zh":"返影入深林，","py":["fǎn","yǐng","rù","shēn","lín",""]},{"zh":"复照青苔上。","py":["fù","zhào","qīng","tái","shàng",""]}],"gist":""},{"id":"ma-shi-li-he","title":"马诗","author":"李贺","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"大漠沙如雪，","py":["dà","mò","shā","rú","xuě",""]},{"zh":"燕山月似钩。","py":["yān","shān","yuè","shì","gōu",""]},{"zh":"何当金络脑，","py":["hé","dāng","jīn","luò","nǎo",""]},{"zh":"快走踏清秋。","py":["kuài","zǒu","tà","qīng","qiū",""]}],"gist":"大漠的沙像雪一样铺天盖地，燕山的月亮像一弯银钩(兵器)。什么时候能够给马套上镶金的笼头，在凉爽的秋天飞快地奔驰在疆场。"},{"id":"min-nong-zhi-er-li-shen","title":"悯农（之二）","author":"李绅","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"春种一粒粟，","py":["chūn","zhòng","yī","lì","sù",""]},{"zh":"秋收万颗子。","py":["qiū","shōu","wàn","kē","zi",""]},{"zh":"四海无闲田，","py":["sì","hǎi","wú","xián","tián",""]},{"zh":"农夫犹饿死。","py":["nóng","fū","yóu","è","sǐ",""]}],"gist":"春天种下一颗种子，秋天收获万颗粮食。到处的田地都耕种了，可还有农民饿死。这是多么不合理的现象呀！"},{"id":"min-nong-zhi-yi-li-shen","title":"悯农（之一）","author":"李绅","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"锄禾日当午，","py":["chú","hé","rì","dāng","wǔ",""]},{"zh":"汗滴禾下土。","py":["hàn","dī","hé","xià","tǔ",""]},{"zh":"谁知盘中餐，","py":["shuí","zhī","pán","zhōng","cān",""]},{"zh":"粒粒皆辛苦。","py":["lì","lì","jiē","xīn","kǔ",""]}],"gist":"这首诗说明粮食来之不易。夏季的正午，烈日当头，给禾苗锄草的农民汗下如雨。有谁知道盘中的饭食，每一粒都来自于辛勤的劳动？"},{"id":"mu-qiu-shan-xing-jie-xuan-cen-can","title":"暮秋山行（节选）","author":"岑参","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"疲马卧长坂，","py":["pí","mǎ","wò","cháng","bǎn",""]},{"zh":"夕阳下通津。","py":["xī","yáng","xià","tōng","jīn",""]},{"zh":"山风吹空林，","py":["shān","fēng","chuī","kōng","lín",""]},{"zh":"飒飒如有人。","py":["sà","sà","rú","yǒu","rén",""]}],"gist":"夕阳照射着通向渡口的道路，疲惫的马卧在山坡旁歇息。山风吹过空旷的树林，发出飒飒的响声，树林里面好像有人的声音。"},{"id":"niao-ming-jian-wang-wei","title":"鸟鸣涧","author":"王维","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"人闲桂花落，","py":["rén","xián","guì","huā","luò",""]},{"zh":"夜静春山空。","py":["yè","jìng","chūn","shān","kōng",""]},{"zh":"月出惊山鸟，","py":["yuè","chū","jīng","shān","niǎo",""]},{"zh":"时鸣春涧中。","py":["shí","míng","chūn","jiàn","zhōng",""]}],"gist":"春夜静悄悄，独自在洒满桂花的山路上悠闲地行走，春山空寂。月亮从云层中露出来，惊动了山林的鸟雀，它们的鸣叫声不时地回荡在春夜的溪涧之中。"},{"id":"qiu-pu-ge-li-bai","title":"秋浦歌","author":"李白","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"白发三千丈，","py":["bái","fà","sān","qiān","zhàng",""]},{"zh":"缘愁似个长。","py":["yuán","chóu","shì","gè","zhǎng",""]},{"zh":"不知明镜里，","py":["bù","zhī","míng","jìng","lǐ",""]},{"zh":"何处得秋霜？","py":["hé","chù","dé","qiū","shuāng",""]}],"gist":""},{"id":"qiu-ye-ji-qiu-yuan-wai-wei-ying-wu","title":"秋夜寄邱员外","author":"韦应物","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"怀君属秋夜，","py":["huái","jūn","shǔ","qiū","yè",""]},{"zh":"散步咏凉天。","py":["sàn","bù","yǒng","liáng","tiān",""]},{"zh":"空山松子落，","py":["kōng","shān","sōng","zi","luò",""]},{"zh":"幽人应未眠。","py":["yōu","rén","yīng","wèi","mián",""]}],"gist":"适逢秋夜天凉，我出外散步吟诗，不禁怀念起君来。空山分外幽静，只听见松子落地的声音。隐居的你，在这个时候一定还没有入睡。"},{"id":"sai-xia-qu-lu-lun","title":"塞下曲","author":"卢纶","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"林暗草惊风，","py":["lín","àn","cǎo","jīng","fēng",""]},{"zh":"将军夜引弓。","py":["jiāng","jūn","yè","yǐn","gōng",""]},{"zh":"平明寻白羽，","py":["píng","míng","xún","bái","yǔ",""]},{"zh":"没在石棱中。","py":["méi","zài","shí","léng","zhōng",""]}],"gist":"夜晚，树林阴暗不明，野草在疾风中颤动，将军拉开了他的弓简明。天刚亮时，去寻找尾部装有白色鸟羽箭矢。箭已射入石中。"},{"id":"shi-dou-quan-gu-kuang","title":"石窦泉","author":"顾况","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"吹沙复喷石，","py":["chuī","shā","fù","pēn","shí",""]},{"zh":"曲折仍圆旋。","py":["qū","zhé","réng","yuán","xuán",""]},{"zh":"野客漱流时，","py":["yě","kè","shù","liú","shí",""]},{"zh":"杯粘落花片。","py":["bēi","zhān","luò","huā","piàn",""]}],"gist":"春风吹拂，泉水就从石头的洞隙里喷出来，有的弯弯曲曲，有的打着圆圈。野外的游客在泉中洗漱时，杯子粘上落下的花瓣。"},{"id":"shi-shang-teng-gu-kuang","title":"石上藤","author":"顾况","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"空山无鸟迹，","py":["kōng","shān","wú","niǎo","jì",""]},{"zh":"何物如人意。","py":["hé","wù","rú","rén","yì",""]},{"zh":"委曲结绳文，","py":["wěi","qū","jié","shéng","wén",""]},{"zh":"离披草书字。","py":["lí","pī","cǎo","shū","zì",""]}],"gist":"荒凉的山崖没有鸟的踪迹，为何这种植物长得像有人修饰。藤蔓弯曲像古代结绳的文字，远看又像在石板上写的草书。"},{"id":"shui-su-wen-yan-li-yi","title":"水宿闻雁","author":"李益","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"早雁忽为双，","py":["zǎo","yàn","hū","wèi","shuāng",""]},{"zh":"惊秋风水凉。","py":["jīng","qiū","fēng","shuǐ","liáng",""]},{"zh":"夜长人自起，","py":["yè","zhǎng","rén","zì","qǐ",""]},{"zh":"星月满空江。","py":["xīng","yuè","mǎn","kōng","jiāng",""]}],"gist":"诗写作者在水边住宿，在早起的一瞬间所见雁群的景象。　　清晨的大雁忽然变成一对对。秋风吹过，江水寒冷，把大雁惊醒，它们迅速地飞离。经过漫漫长夜，我起身只见天上布满星月，映照在空落落的江水之上。"},{"id":"song-bie-wang-wei","title":"送别","author":"王维","dynasty":"唐","form":"五言绝句","themes":["送别","友情"],"level":0,"lines":[{"zh":"山中相送罢，","py":["shān","zhōng","xiāng","sòng","bà",""]},{"zh":"日暮掩柴扉。","py":["rì","mù","yǎn","chái","fēi",""]},{"zh":"春草明年绿，","py":["chūn","cǎo","míng","nián","lǜ",""]},{"zh":"王孙归不归？","py":["wáng","sūn","guī","bù","guī",""]}],"gist":""},{"id":"song-li-shi-yi-wang-wei","title":"送黎拾遗","author":"王维","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"相送临高台，","py":["xiāng","sòng","lín","gāo","tái",""]},{"zh":"川原杳何极！","py":["chuān","yuán","yǎo","hé","jí",""]},{"zh":"日暮飞鸟还，","py":["rì","mù","fēi","niǎo","hái",""]},{"zh":"行人去不息。","py":["xíng","rén","qù","bù","xī",""]}],"gist":"登上高台送别黎昕，只见山川原野广阔遥远。太阳落山时，飞鸟回到自已的林中巢穴，远行的人一去不再回来。"},{"id":"song-ling-che-liu-zhang-qing","title":"送灵澈","author":"刘长卿","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"苍苍竹林寺，","py":["cāng","cāng","zhú","lín","sì",""]},{"zh":"杳杳种声晚。","py":["yǎo","yǎo","zhǒng","shēng","wǎn",""]},{"zh":"荷笠带斜阳，","py":["hé","lì","dài","xié","yáng",""]},{"zh":"青山独归远。","py":["qīng","shān","dú","guī","yuǎn",""]}],"gist":"暮色苍茫笼罩着的竹林寺，傍晚从远处传来阵阵钏声。在夕阳的辉映中，灵澈和尚肩负斗笠，他孤独的身影消失在那遥远的青山中。"},{"id":"su-jian-de-jiang-meng-hao-ran","title":"宿建德江","author":"孟浩然","dynasty":"唐","form":"五言绝句","themes":["描写水","写景","思乡","水","月亮","写水"],"level":0,"lines":[{"zh":"移舟泊烟渚，","py":["yí","zhōu","pō","yān","zhǔ",""]},{"zh":"日暮客愁新。","py":["rì","mù","kè","chóu","xīn",""]},{"zh":"野旷天低树，","py":["yě","kuàng","tiān","dī","shù",""]},{"zh":"江清月近人。","py":["jiāng","qīng","yuè","jìn","rén",""]}],"gist":""},{"id":"ti-san-hui-si-cang-jie-zao-zi-tai-cen-can","title":"题三会寺仓颉造字台","author":"岑参","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"野寺荒台晚，","py":["yě","sì","huāng","tái","wǎn",""]},{"zh":"寒天古木悲。","py":["hán","tiān","gǔ","mù","bēi",""]},{"zh":"空阶有鸟迹，","py":["kōng","jiē","yǒu","niǎo","jì",""]},{"zh":"犹似造书时。","py":["yóu","shì","zào","shū","shí",""]}],"gist":"傍晚，来到这荒野寺庙的古台，天气寒冷，古老的树木在冷风中悲鸣。三会寺的空阶上只残留鸟的足迹，就像仓颉当年造字的时候一样。"},{"id":"ti-san-lv-da-fu-miao-dai-shu-lun","title":"题三闾大夫庙","author":"戴叔伦","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"沅湘流不尽，","py":["yuán","xiāng","liú","bù","jìn",""]},{"zh":"屈子怨何深。","py":["qū","zi","yuàn","hé","shēn",""]},{"zh":"日暮秋风起，","py":["rì","mù","qiū","fēng","qǐ",""]},{"zh":"萧萧枫树林。","py":["xiāo","xiāo","fēng","shù","lín",""]}],"gist":"沅江、湘江的水长流不断，诉说着屈原多么深的怨恨。太阳西下，秋风萧瑟，枫树摇曳，恍惚中如见屈原归来。"},{"id":"ting-zheng-li-duan","title":"听筝","author":"李端","dynasty":"唐","form":"五言绝句","themes":["音乐"],"level":0,"lines":[{"zh":"鸣筝金粟柱，","py":["míng","zhēng","jīn","sù","zhù",""]},{"zh":"素手玉房前。","py":["sù","shǒu","yù","fáng","qián",""]},{"zh":"欲得周郎顾，","py":["yù","dé","zhōu","láng","gù",""]},{"zh":"时时误拂弦。","py":["shí","shí","wù","fú","xián",""]}],"gist":"一个女子在她的闺房，用她洁白纤细的手指弹着一张装饰着金星的华美的鸣筝。为了想得到像三国周瑜一样的知音的顾望，她不时地把弦故意拨错。"},{"id":"wen-liu-shi-jiu-bai-ju-yi","title":"问刘十九","author":"白居易","dynasty":"唐","form":"五言绝句","themes":["生活","饮酒","友情"],"level":0,"lines":[{"zh":"绿蚁新醅酒，","py":["lǜ","yǐ","xīn","pēi","jiǔ",""]},{"zh":"红泥小火炉。","py":["hóng","ní","xiǎo","huǒ","lú",""]},{"zh":"晚来天欲雪，","py":["wǎn","lái","tiān","yù","xuě",""]},{"zh":"能饮一杯无？","py":["néng","yǐn","yī","bēi","wú",""]}],"gist":"此诗表现白居易的好客。　　新酿的美酒，酒滓像绿蚂蚁一样浮在表面，用红泥做的小火炉刚温好酒。晚上天要下雪了，来饮一杯吗？"},{"id":"wu-cheng-li-duan","title":"芜城","author":"李端","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"风吹城上树，","py":["fēng","chuī","chéng","shàng","shù",""]},{"zh":"草没城边路。","py":["cǎo","méi","chéng","biān","lù",""]},{"zh":"城里月明时，","py":["chéng","lǐ","yuè","míng","shí",""]},{"zh":"精灵自来去。","py":["jīng","líng","zì","lái","qù",""]}],"gist":"大风吹拂着生长在城墙边的树木，野草淹没了城边的大路。城里没有人迹，在月明的夜晚，精灵鬼怪自由自在地进出。"},{"id":"xiang-si-wang-wei","title":"相思","author":"王维","dynasty":"唐","form":"五言绝句","themes":["思念","咏物","抒情"],"level":0,"lines":[{"zh":"红豆生南国，","py":["hóng","dòu","shēng","nán","guó",""]},{"zh":"春来发几枝？","py":["chūn","lái","fā","jǐ","zhī",""]},{"zh":"愿君多采撷，","py":["yuàn","jūn","duō","cǎi","xié",""]},{"zh":"此物最相思。","py":["cǐ","wù","zuì","xiāng","sī",""]}],"gist":"红豆生长在南方，春天来到，它又长出了多少新的枝条？劝你多采撷一些红豆，因为它能唤起你思念的情感。"},{"id":"xiao-fa-he-zhi-zhang","title":"晓发","author":"贺知章","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"故乡杳无际，","py":["gù","xiāng","yǎo","wú","jì",""]},{"zh":"江皋闻曙钟。","py":["jiāng","gāo","wén","shǔ","zhōng",""]},{"zh":"始见沙上鸟，","py":["shǐ","jiàn","shā","shàng","niǎo",""]},{"zh":"犹埋云外峰。","py":["yóu","mái","yún","wài","fēng",""]}],"gist":"这首诗描写了晓雾初开清晨的景色，表达了作者对故乡的眷恋和对前路的渺茫之感。　　故乡已是遥远而没有边际，江岸传来了清晨的钟声。近处可以清晰地看见沙滩的水鸟，远处的山峰还隐没于云雾之中。"},{"id":"xin-jia-niang-wang-jian","title":"新嫁娘","author":"王建","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"三日入厨下，","py":["sān","rì","rù","chú","xià",""]},{"zh":"洗手作羹汤。","py":["xǐ","shǒu","zuò","gēng","tāng",""]},{"zh":"未谙姑食性，","py":["wèi","ān","gū","shí","xìng",""]},{"zh":"先遣小姑尝。","py":["xiān","qiǎn","xiǎo","gū","cháng",""]}],"gist":"此诗朴素生动地刻划了封建社会媳妇对婆婆，特别是新嫁娘初到婆婆家，那种畏惧谨慎的心理状态。　　按照习俗，新嫁娘婚后的第三天要下厨做菜。　　第三天下厨房，洗手后煮羹汤，不熟悉婆婆的口味，先请小姑尝试。"},{"id":"xing-gong-yuan-zhen","title":"行宫","author":"元稹","dynasty":"唐","form":"五言绝句","themes":["怀古","宫怨"],"level":0,"lines":[{"zh":"寥落古行宫，","py":["liáo","luò","gǔ","xíng","gōng",""]},{"zh":"宫花寂寞红。","py":["gōng","huā","jì","mò","hóng",""]},{"zh":"白头宫女在，","py":["bái","tóu","gōng","nǚ","zài",""]},{"zh":"闲坐说玄宗。","py":["xián","zuò","shuō","xuán","zōng",""]}],"gist":"过去的行宫一片冷落，宫中的春花再无人欣赏。白头发的宫女住在里面，闲谈玄宗往事。"},{"id":"xing-jun-jiu-ri-si-chang-an-gu-yuan-cen-can","title":"行军九日思长安故园","author":"岑参","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"强欲登高去，","py":["qiáng","yù","dēng","gāo","qù",""]},{"zh":"无人送酒来。","py":["wú","rén","sòng","jiǔ","lái",""]},{"zh":"遥怜故园菊，","py":["yáo","lián","gù","yuán","jú",""]},{"zh":"应傍战场开。","py":["yīng","bàng","zhàn","chǎng","kāi",""]}],"gist":""},{"id":"yi-shui-song-ren-luo-bin-wang","title":"易水送人","author":"骆宾王","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"此地别燕丹，","py":["cǐ","dì","bié","yàn","dān",""]},{"zh":"壮发上冲冠。","py":["zhuàng","fà","shàng","chōng","guān",""]},{"zh":"昔时人已没，","py":["xī","shí","rén","yǐ","méi",""]},{"zh":"今日水犹寒。","py":["jīn","rì","shuǐ","yóu","hán",""]}],"gist":"在这个地方荆轲告别燕太子丹，慷慨赴义，怒发冲冠。岁月匆匆，过去的人都不在了，只留下易水还和当年一样冰冷。"},{"id":"yi-song-yi-gu-kuang","title":"欹松漪","author":"顾况","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"湛湛碧涟漪，","py":["zhàn","zhàn","bì","lián","yī",""]},{"zh":"老松欹侧卧。","py":["lǎo","sōng","yī","cè","wò",""]},{"zh":"悠扬绿萝影，","py":["yōu","yáng","lǜ","luó","yǐng",""]},{"zh":"下拂波纹破。","py":["xià","fú","bō","wén","pò",""]}],"gist":"碧绿湛湛的波涛上，老松树斜躺在岸边。疾风吹过，松枝摇曳，划破水中的涟漪，水面映照出它的倒影。"},{"id":"yuan-qing-li-bai","title":"怨情","author":"李白","dynasty":"唐","form":"五言绝句","themes":["女子"],"level":0,"lines":[{"zh":"美人卷珠帘，","py":["měi","rén","juǎn","zhū","lián",""]},{"zh":"深坐颦蛾眉。","py":["shēn","zuò","pín","é","méi",""]},{"zh":"但见泪痕湿，","py":["dàn","jiàn","lèi","hén","shī",""]},{"zh":"不知心恨谁？","py":["bù","zhī","xīn","hèn","shuí",""]}],"gist":"珠帘高卷，美女深坐闺阁愁眉不展。只见她眼泪涟涟，却不知她心里在怨恨哪一个。"},{"id":"zhong-nan-wang-yu-xue-zu-yong","title":"终南望余雪","author":"祖咏","dynasty":"唐","form":"五言绝句","themes":["写雪","写景","雪","冬"],"level":0,"lines":[{"zh":"终南阴岭秀，","py":["zhōng","nán","yīn","lǐng","xiù",""]},{"zh":"积雪浮云端。","py":["jī","xuě","fú","yún","duān",""]},{"zh":"林表明霁色，","py":["lín","biǎo","míng","jì","sè",""]},{"zh":"城中增暮寒。","py":["chéng","zhōng","zēng","mù","hán",""]}],"gist":""},{"id":"zhu-li-guan-wang-wei","title":"竹里馆","author":"王维","dynasty":"唐","form":"五言绝句","themes":[],"level":0,"lines":[{"zh":"独坐幽篁里，","py":["dú","zuò","yōu","huáng","lǐ",""]},{"zh":"弹琴复长啸。","py":["tán","qín","fù","cháng","xiào",""]},{"zh":"深林人不知，","py":["shēn","lín","rén","bù","zhī",""]},{"zh":"明月来相照。","py":["míng","yuè","lái","xiāng","zhào",""]}],"gist":""},{"id":"fu-de-gu-yuan-cao-song-bie-bai-ju-yi","title":"赋得古原草送别","author":"白居易","dynasty":"唐","form":"五言律诗","themes":["写草","二年级下册","咏物","送别","小学古诗"],"level":1,"lines":[{"zh":"离离原上草，","py":["lí","lí","yuán","shàng","cǎo",""]},{"zh":"一岁一枯荣。","py":["yī","suì","yī","kū","róng",""]},{"zh":"野火烧不尽，","py":["yě","huǒ","shāo","bù","jìn",""]},{"zh":"春风吹又生。","py":["chūn","fēng","chuī","yòu","shēng",""]}],"gist":""},{"id":"bie-dong-da-gao-shi","title":"别董大","author":"高适","dynasty":"唐","form":"七言绝句","themes":[],"level":1,"lines":[{"zh":"千里黄云白日曛，","py":["qiān","lǐ","huáng","yún","bái","rì","xūn",""]},{"zh":"北风吹雁雪纷纷。","py":["běi","fēng","chuī","yàn","xuě","fēn","fēn",""]},{"zh":"莫愁前路无知己，","py":["mò","chóu","qián","lù","wú","zhī","jǐ",""]},{"zh":"天下谁人不识君？","py":["tiān","xià","shuí","rén","bù","shí","jūn",""]}],"gist":""},{"id":"chang-e-li-shang-yin","title":"嫦娥","author":"李商隐","dynasty":"唐","form":"七言绝句","themes":[],"level":1,"lines":[{"zh":"云母屏风烛影深，","py":["yún","mǔ","píng","fēng","zhú","yǐng","shēn",""]},{"zh":"长河渐落晓星沉。","py":["cháng","hé","jiàn","luò","xiǎo","xīng","chén",""]},{"zh":"嫦娥应悔偷灵药，","py":["cháng","é","yīng","huǐ","tōu","líng","yào",""]},{"zh":"碧海青天夜夜心。","py":["bì","hǎi","qīng","tiān","yè","yè","xīn",""]}],"gist":"云母石装饰的屏风旁，烛影深深；银河西移，启明星渐渐消失。月中仙女嫦娥应当懊悔当初偷吃了不死灵药，以致在月宫夜夜对着碧海青天，过着孤寂凄冷的生活。"}]